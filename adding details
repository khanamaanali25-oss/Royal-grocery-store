.products {
  margin: 20px;
}

.products h2 {
  margin: 20px 0;
  color: #2c3e50;
}

.product-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.product {
  flex: 1 1 180px;
  max-width: 200px;
  text-align: center;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 10px;
  background-color: #fdfdfd;
}

.product img {
  width: 100%;
  height: 150px;
  object-fit: cover;
  border-radius: 6px;
}

.product h3 {
  margin: 10px 0 5px;
  font-size: 1.1em;
}

.product p {
  color: #555;
  margin-bottom: 10px;
}

.product button {
  background-color: #27ae60;
  color: white;
  border: none;
  padding: 8px 12px;
  border-radius: 4px;
  cursor: pointer;
}

.product button:hover {
  background-color: #219150;
}


